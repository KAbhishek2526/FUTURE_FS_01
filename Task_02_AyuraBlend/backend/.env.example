# =========================================================================
# AYURABLEND BACKEND - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Rename this file to .env in your local environment, or configure these
# variables inside your Render / AWS / Container hosting dashboard.
# =========================================================================

# 1. Server Configuration
PORT=5001
NODE_ENV=production

# 2. Database Connection
# Replace with your secure remote MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ayurablend_prod?retryWrites=true&w=majority

# 3. Razorpay Live Payments Gateway
RAZORPAY_LIVE_KEY_ID=rzp_live_yourLiveKeyId
RAZORPAY_LIVE_KEY_SECRET=yourLiveKeySecret
RAZORPAY_WEBHOOK_SECRET=yourConfiguredWebhookSecret

# 4. Shiprocket Live Logistics
SHIPROCKET_EMAIL=shipping@yourdomain.com
SHIPROCKET_PASSWORD=yourSecureShiprocketPassword

# 5. Security Credentials
# Generate a highly secure random string for JWT sign authorizations
JWT_SECRET=superSecretJWTTokenSigningKey_6a8b7c9d
JWT_EXPIRE=30d

# 6. Email (SMTP / OTP Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=otp-alerts@yourdomain.com
SMTP_PASS=yourSecureAppPassword
